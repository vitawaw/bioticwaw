    // the test project (preview links) — only woken up by the daily cron
    "TEST_SUPABASE_URL": "https://ehmucaelvxrftspkqrtq.supabase.co",
    "TEST_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVobXVjYWVsdnhyZnRzcGtxcnRxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQyMTU4NjEsImV4cCI6MjEwOTc5MTg2MX0.0rT591287VaTPMb3R6GXRT6D54DGrHSqmZ_mkEyrh6w"
  },
