// Cloudflare Workers configuration. Deployed automatically by Workers Builds from GitHub:
// branch "main" -> production (npx wrangler deploy), any other branch -> preview (npx wrangler preview).
{
  "name": "bioticwaw",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // only /api/* runs the worker; every other request is a free static asset
    "run_worker_first": ["/api/*"]
  },
  // public values only (the anon key is meant to be public; data is protected by RLS)
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": "",
    // the test project (preview links) — only woken up by the daily cron
    "TEST_SUPABASE_URL": "",
    "TEST_SUPABASE_ANON_KEY": ""
  },
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true },
  // previews use the separate free test project «bioticwaw-test» (same tables, its own data), so a preview never touches the live site
  "previews": {
    "vars": {
      "SUPABASE_URL": "",
      "SUPABASE_ANON_KEY": ""
    }
  }
}
